# Database configuration
DATABASE_URL=postgresql://app_user:querytrust_app_dev@localhost:5432/querytrust
READONLY_DATABASE_URL=postgresql://analytics_reader:querytrust_reader_dev@localhost:5432/querytrust

# Application configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
# Security & Encryption
SECRET_KEY=dev-super-secret-key-change-in-production-querytrust-2026
DATA_SOURCE_ENCRYPTION_KEY=  # Dedicated encryption key for external database credentials (NIST SP 800-133)
ENCRYPTION_KEY=  # Backward-compatible alias
DATA_SOURCE_KEY_ROTATION_FALLBACKS=  # Optional comma-separated prior keys for zero-downtime key rotation
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Demo Mode & Pre-Provisioning
DEMO_MODE=true  # Set to false in production to disable demo shortcuts and demo user seeding
DEMO_ADMIN_PASSWORD=AdminPass123!
DEMO_ANALYST_PASSWORD=AnalystPass123!
DEMO_VIEWER_PASSWORD=ViewerPass123!
DEFAULT_TEMP_PASSWORD=WelcomePass123!  # Default initial password for approved access requests in demo/test mode

# LLM Provider configuration ('demo' | 'gemini' | 'openai_compatible')
LLM_PROVIDER=demo
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Execution & Network Safeguards
RATE_LIMIT_PER_MINUTE=60
DATASOURCE_BLOCKED_HOSTS=localhost,127.0.0.1,0.0.0.0,::1,169.254.169.254,metadata.google.internal
