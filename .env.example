# Database configuration
DATABASE_URL=postgresql://app_user:querytrust_app_dev@localhost:5432/querytrust
READONLY_DATABASE_URL=postgresql://analytics_reader:querytrust_reader_dev@localhost:5432/querytrust

# Application configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=dev-super-secret-key-change-in-production-querytrust-2026
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM Provider configuration ('demo' | 'gemini' | 'openai_compatible')
LLM_PROVIDER=demo
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
